# Provider planning is deterministic when no key is configured. `auto` may use
# Gemini only after the backend verifies the exact model and a canary request.
ARRAX_AI_MODE=auto
GEMINI_API_KEY=
# Candidate example only; model names and account access are account-dependent.
GEMINI_MODEL=gemini-3.8-flash

# Optional: leave blank to keep the workspace capability disabled.
# ARRAX_WORKSPACE_ROOT=
# Keep this file as the safe template for local configuration.
# Never commit a real .env file, credentials, tokens, or personal data.
